    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,scss}\""
  },
  "dependencies": {
    "@easemob/uikit-core": "file:./easemob-uikit-core-1.1.0.tgz",
    "@easemob/uikit-im": "file:./easemob-uikit-im-2.3.0.tgz",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "axios-mock-adapter": "^2.1.0",
    "eruda": "^3.4.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "overrides": {
      "@easemob/uikit-core": "file:./easemob-uikit-core-1.1.0.tgz",
      "@easemob/uikit-im": "file:./easemob-uikit-im-2.3.0.tgz"
